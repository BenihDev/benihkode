---
import { type CollectionEntry, getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { SITE_EMAIL } from '../../../consts';
import { getPrivacyPolicyStaticPaths, handWrittenAppPageSlugs } from '../../../utils/projects';

export async function getStaticPaths() {
	// File presence is the escape hatch: a hand-written page at
	// src/pages/apps/<slug>/privacy.astro publishes the same URL, so the
	// generated route must not emit a second page for that App.
	const handWrittenSlugs = handWrittenAppPageSlugs(
		'privacy',
		import.meta.glob('/src/pages/apps/*/privacy.astro'),
	);

	const projects = await getCollection('projects');
	return getPrivacyPolicyStaticPaths(projects, handWrittenSlugs);
}

type Props = CollectionEntry<'projects'>;

const app = Astro.props;
const doc = await getEntry('appPages', app.id);
if (!doc) {
	throw new Error(`No privacy document for distributed App '${app.id}' — expected src/content/app-pages/${app.id}.md`);
}
const { Content } = await render(doc);
const appName = app.data.appName || app.data.title;
const lastUpdated = new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout title={`Privacy Policy — ${appName}`} description={`Privacy policy for ${appName} application.`}>
	<section style="padding-top: 4rem;">
		<div class="container">
			<div class="privacy-content">
				<a href={`/apps/${app.id}`} class="back-link"><span aria-hidden="true">←</span> Back to {appName}</a>
				<h1>Privacy Policy</h1>
				<p class="app-name">for <strong>{appName}</strong></p>
				<p class="last-updated">Last updated: {lastUpdated}</p>

				<Content />

				<h2>Contact Us</h2>
				<p>
					If you have any questions or suggestions about this Privacy Policy, do not hesitate to contact us at <a href={`mailto:${SITE_EMAIL}`}>{SITE_EMAIL}</a>.
				</p>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.privacy-content {
		max-width: 680px;
		line-height: 1.8;
	}
	h1 { margin-bottom: 0.25rem; }
	.app-name { font-size: 1.1rem; color: var(--text-secondary); margin-bottom: 0.25rem; }
	.last-updated {
		font-family: 'JetBrains Mono', monospace; font-size: 0.75rem;
		color: var(--text-muted); margin-bottom: 2rem;
	}
	h2 { margin-top: 2rem; margin-bottom: 0.75rem; font-size: 1.3rem; }
	p { margin-bottom: 1rem; color: var(--text-secondary); }
	ul {
		list-style: disc; padding-left: 1.5rem; margin-bottom: 1rem;
	}
	li { margin-bottom: 0.5rem; color: var(--text-secondary); }
	a { color: var(--accent); }
</style>
