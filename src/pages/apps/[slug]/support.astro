---
import { type CollectionEntry, getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AppPageShell from '../../../components/AppPageShell.astro';
import { getSupportStaticPaths, handWrittenAppPageSlugs } from '../../../utils/projects';

export async function getStaticPaths() {
	// File presence is the escape hatch: a hand-written page at
	// src/pages/apps/<slug>/support.astro publishes the same URL, so the
	// generated route must not emit a second page for that App.
	const handWrittenSlugs = handWrittenAppPageSlugs(
		'support',
		import.meta.glob('/src/pages/apps/*/support.astro'),
	);

	const projects = await getCollection('projects');
	return getSupportStaticPaths(projects, handWrittenSlugs);
}

type Props = CollectionEntry<'projects'>;

const app = Astro.props;
const doc = await getEntry('appPages', `${app.id}-support`);
if (!doc) {
	throw new Error(`No support document for distributed App '${app.id}' — expected src/content/app-pages/${app.id}-support.md`);
}
const { Content } = await render(doc);
const appName = app.data.appName || app.data.title;
---

<BaseLayout title={`Support — ${appName}`} description={`Support for ${appName}. Contact us and learn how to report a problem.`}>
	<AppPageShell kind="support" appId={app.id} appName={appName}>
		<Content />
	</AppPageShell>
</BaseLayout>
